# =============================================================================
# AI SERVICE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values

# =============================================================================
# AI SERVICE CONFIGURATION
# =============================================================================

# AI Service Port
AI_SERVICE_PORT=5000

# Debug Mode (true/false)
DEBUG_MODE=true

# Backend API URL
BACKEND_API_URL=http://localhost:3001

# =============================================================================
# AI MODEL API KEYS
# =============================================================================

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey) - PRIMARY & FREE TIER
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (get from https://platform.openai.com/api-keys) - PAID
OPENAI_API_KEY=sk-your-openai-api-key-here

# Claude API Key (get from https://console.anthropic.com/) - PAID (OPTIONAL)
CLAUDE_API_KEY=your-claude-api-key-here

# LM Studio Configuration (for local AI models)
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_API_KEY=lm-studio-key

# =============================================================================
# LAZAI BLOCKCHAIN CONFIGURATION
# =============================================================================

# Your LazAI wallet private key
PRIVATE_KEY=your_lazai_private_key_here

# Your Pinata IPFS JWT token
IPFS_JWT=your_pinata_jwt_token_here

# Optional: Custom RPC URL (defaults to LazAI testnet)
LAZAI_RPC_URL=https://testnet.lazai.network

# Optional: Custom chain ID (defaults to 133718 for LazAI testnet)
LAZAI_CHAIN_ID=133718