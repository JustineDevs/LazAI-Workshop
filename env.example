# DataStreamNFT Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================

# Ethereum RPC URL (use your preferred provider)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# Alternative RPC URLs:
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# RPC_URL=https://rpc.sepolia.org

# Private key for contract deployment and backend operations
# WARNING: Never commit this to version control!
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Network configuration
NETWORK_ID=11155111
NETWORK_NAME=sepolia
CHAIN_ID=11155111

# =============================================================================
# SMART CONTRACT ADDRESSES
# =============================================================================

# DataStreamNFT Contract Address (deployed)
DATASTREAM_NFT_ADDRESS=0x1868C3935B5A548C90d5660981FB866160382Da7

# DataStreamDAT Contract Address (deployed)
DATASTREAM_DAT_ADDRESS=0x1868C3935B5A548C90d5660981FB866160382Da7

# DAT Token Contract Address (if using ERC20 payments)
DAT_TOKEN_ADDRESS=0x...

# Platform Treasury Address (for fee collection)
PLATFORM_TREASURY_ADDRESS=0x1234567890123456789012345678901234567890

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Next.js public environment variables (accessible in browser)
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
NEXT_PUBLIC_NETWORK_ID=11155111
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=sepolia

# Contract addresses (public)
NEXT_PUBLIC_DATASTREAM_NFT_ADDRESS=0x1868C3935B5A548C90d5660981FB866160382Da7
NEXT_PUBLIC_DATASTREAM_DAT_ADDRESS=0x1868C3935B5A548C90d5660981FB866160382Da7
NEXT_PUBLIC_DAT_TOKEN_ADDRESS=0x...

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================

# Server configuration
PORT=3001
NODE_ENV=development
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session configuration
SESSION_SECRET=your-session-secret-key-change-this-in-production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/datastreamnft
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/datastreamnft

# Database name
DB_NAME=datastreamnft

# =============================================================================
# AI/ML PROVIDER API KEYS
# =============================================================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API Key
GROQ_API_KEY=gsk_your-groq-api-key-here

# LazAI API Key (if using LazAI services)
LAZAI_API_KEY=your-lazai-api-key-here

# =============================================================================
# IPFS CONFIGURATION
# =============================================================================

# Pinata API credentials
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_KEY=your-pinata-secret-key

# IPFS Gateway URL
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Alternative IPFS providers:
# INFURA_IPFS_PROJECT_ID=your-infura-ipfs-project-id
# INFURA_IPFS_PROJECT_SECRET=your-infura-ipfs-project-secret

# =============================================================================
# COMMUNITY INTEGRATION
# =============================================================================

# Discord Webhook URL for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Bot Token (for advanced features)
DISCORD_BOT_TOKEN=your-discord-bot-token

# Discord Guild ID
DISCORD_GUILD_ID=your-discord-server-id

# Discord Invite URL
DISCORD_INVITE_URL=https://discord.gg/datastreamnft

# Social Media Links
TWITTER_URL=https://twitter.com/datastreamnft
GITHUB_URL=https://github.com/datastreamnft
TELEGRAM_URL=https://t.me/datastreamnft

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Encryption key for sensitive data
ENCRYPTION_KEY=your-32-character-encryption-key

# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path
LOG_FILE_PATH=./logs/app.log

# Sentry DSN for error tracking
SENTRY_DSN=your-sentry-dsn-here

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis connection string (for caching)
REDIS_URL=redis://localhost:6379

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email templates
EMAIL_FROM=noreply@datastreamnft.com
EMAIL_FROM_NAME=DataStreamNFT

# =============================================================================
# ANALYTICS AND TRACKING
# =============================================================================

# Google Analytics ID
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Mixpanel Token
MIXPANEL_TOKEN=your-mixpanel-token

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable debug mode
DEBUG=true

# Enable verbose logging
VERBOSE_LOGGING=true

# Test mode (disable real blockchain transactions)
TEST_MODE=false

# Mock AI responses (for development)
MOCK_AI_RESPONSES=false

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# SSL configuration
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# CDN configuration
CDN_URL=https://cdn.datastreamnft.com

# Load balancer configuration
LOAD_BALANCER_IP=your-load-balancer-ip

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_COMMUNITY_FEATURES=true
ENABLE_DISCORD_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_QUERY_CHAINING=true
ENABLE_MULTI_LLM_PROVIDERS=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Maximum file upload size (in bytes)
MAX_FILE_SIZE=104857600

# Maximum concurrent uploads
MAX_CONCURRENT_UPLOADS=5

# Query timeout (in milliseconds)
QUERY_TIMEOUT=30000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup frequency (in hours)
BACKUP_FREQUENCY=24

# Backup retention (in days)
BACKUP_RETENTION=30

# Backup storage path
BACKUP_PATH=/path/to/backups

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Webhook endpoints for notifications
WEBHOOK_URL_UPLOAD=https://your-app.com/webhooks/upload
WEBHOOK_URL_QUERY=https://your-app.com/webhooks/query
WEBHOOK_URL_EARNINGS=https://your-app.com/webhooks/earnings

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Custom configuration for your specific deployment
CUSTOM_CONFIG_1=value1
CUSTOM_CONFIG_2=value2

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit the actual .env file to version control
# 2. Use strong, unique secrets for production
# 3. Rotate API keys regularly
# 4. Use environment-specific values for different deployments
# 5. Test all configurations before deploying to production
# 6. Keep backup copies of your environment configuration
# 7. Use a secrets management service for production deployments