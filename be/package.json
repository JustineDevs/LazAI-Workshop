{
  "name": "lazai-workshop-backend",
  "version": "1.0.0",
  "description": "Backend API for LazAI Workshop - Web3 Data Monetization with AI Agents",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/simple-app.js",
    "dev": "nodemon src/simple-app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "deploy:contracts": "cd ../smc && npx hardhat run scripts/deploy.js",
    "deploy:upgradeable": "cd ../smc && npx hardhat run scripts/deploy-upgradeable.js"
  },
  "keywords": [
    "web3",
    "ai",
    "nft",
    "data-monetization",
    "lazai",
    "ipfs",
    "blockchain"
  ],
  "author": "LazAI Workshop Team",
  "license": "MIT",
  "dependencies": {
    "@pinata/sdk": "^2.1.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "web3": "^4.3.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
