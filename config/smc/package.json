{
  "name": "lazai-workshop-smart-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for LazAI Workshop - Web3 Data Monetization with AI Agents",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
