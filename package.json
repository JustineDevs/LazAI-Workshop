{
  "name": "datastreamnft",
  "version": "1.0.0",
  "description": "Revolutionary Data Monetization Platform",
  "main": "src/api/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon src/api/server.js",
    "dev:frontend": "cd fe && npm run dev",
    "build": "npm run build:contracts && npm run build:backend && npm run build:frontend",
    "build:contracts": "hardhat compile",
    "build:backend": "echo 'Backend build complete'",
    "build:frontend": "cd fe && npm run build",
    "start": "node src/api/server.js",
    "test": "npm run test:contracts && npm run test:backend && npm run test:frontend && npm run test:e2e",
    "test:contracts": "hardhat test",
    "test:backend": "mocha tests/backend/**/*.test.js --timeout 10000",
    "test:frontend": "cd fe && npm test",
    "test:e2e": "playwright test",
    "test:coverage": "nyc npm test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:upgradeable": "hardhat run scripts/deploy-upgradeable.js",
    "deploy:testnet": "hardhat run scripts/deploy-lazai.js --network lazchain",
    "deploy:mainnet": "hardhat run scripts/deploy-production.js --network lazchain",
    "upgrade:contract": "hardhat run scripts/upgrade-contract.js",
    "verify:contracts": "hardhat verify --network lazchain",
    "monitor": "node scripts/monitor.js",
    "health-check": "node scripts/health-check.js"
  },
  "keywords": [
    "NFT",
    "data-monetization",
    "blockchain",
    "AI",
    "micropayments",
    "Lazchain",
    "IPFS"
  ],
  "author": "DataStreamNFT Team",
  "license": "MIT",
  "dependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^4.8.3",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "axios": "^1.12.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "chai": "^4.3.10",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "nyc": "^15.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
