# DataStreamNFT Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# PUBLIC CONFIGURATION (safe to expose in frontend)
# =============================================================================

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# AI Service URL
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:5000

# Blockchain Network Configuration
NEXT_PUBLIC_CHAIN_ID=133718
NEXT_PUBLIC_NETWORK_NAME=LazAI Testnet
NEXT_PUBLIC_RPC_URL=https://testnet.lazai.network

# Contract Addresses (update after deployment)
NEXT_PUBLIC_DATASTREAM_NFT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DATASTREAM_DAT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DAT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable test mode (uses mock data and contracts)
NEXT_PUBLIC_TEST_MODE=true

# Enable mock AI responses (for development without API keys)
NEXT_PUBLIC_MOCK_AI_RESPONSES=true

# Enable debug logging
NEXT_PUBLIC_DEBUG=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable frontend features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_COMMUNITY_FEATURES=true
NEXT_PUBLIC_ENABLE_QUERY_METERING=true
NEXT_PUBLIC_ENABLE_AI_INTEGRATION=true

# =============================================================================
# NOTES
# =============================================================================

# 1. Copy this file to .env.local
# 2. Update contract addresses after deployment
# 3. Set NEXT_PUBLIC_TEST_MODE=false for production
# 4. All NEXT_PUBLIC_ variables are exposed to the browser
# 5. Never put sensitive data in NEXT_PUBLIC_ variables
